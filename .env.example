# ============================================================
# MentorOS Cloud - ortam degiskenleri
#
# YEREL GELISTIRME:
#     Bu dosyayi .env olarak kopyalayin ve degerleri doldurun.
#
# BULUT KURULUMU:
#     .env dosyasi KULLANILMAZ. Asagidaki degerleri bulut
#     saglayicinizin "Environment Variables" ekranina girin.
# ============================================================

PORT=3000

# ------------------------------------------------------------
# BULUT MODU
#
# true  -> HTTPS arkasinda calisiyoruz:
#            - oturum cerezi "secure" isaretlenir
#            - ters vekil basliklarina guvenilir (gercek ziyaretci IP'si)
#            - deneme/lisans kapisi devre disi (erisim hesap bazlidir)
# false -> yerel gelistirme (http://localhost)
# ------------------------------------------------------------
CLOUD=true

# Davet ve onay linklerinde kullanilacak ADRES.
# Bulutta kendi alan adinizi yazin. Yanlis olursa gonderilen
# linkler acilmaz - hata vermez, sadece calismaz.
SITE_BASE_URL=https://mentoros.example.com

# ------------------------------------------------------------
# VERITABANI
#
# BULUTTA KALICI DISKE ISARET ETMELI.
# Saglayicinin gecici diskine yazarsaniz sunucu her yeniden
# baslatildiginda TUM VERI SILINIR.
# Ornek (Render kalici disk):  /var/data/mentoros.db
# ------------------------------------------------------------
DB_PATH=/var/data/mentoros.db

# ------------------------------------------------------------
# YONETICI (super admin) GIRISI
#
# Kullanici adi ile /login.html uzerinden girilir ve firma
# hesaplarini bu panelden olusturursunuz.
#
# Hash uretmek icin:  npm run hash-password
# ------------------------------------------------------------
SUPER_ADMIN_USER=superadmin
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------
# AYAR SIFRELEME ANAHTARI  (ZORUNLU)
#
# Claude API anahtarini veritabaninda sifreler.
#
# DIKKAT: Bos birakilirsa uygulama her aciliste YENI bir anahtar
# uretir ve daha once kaydedilmis API anahtarini OKUYAMAZ.
# Yerelde bu deger .env'e yazilarak cozuluyordu; bulutta dosya
# sistemi kalici olmadigi icin BURADA SABITLENMELIDIR.
#
# Uretmek icin:  npm run hash-password
# ------------------------------------------------------------
SETTINGS_SECRET=

# ------------------------------------------------------------
# GIZLILIK
#
# true -> isimler, e-postalar ve telefonlar yapay zekaya
#         gonderilmeden once maskelenir. URETIMDE KAPATMAYIN.
# ------------------------------------------------------------
PII_SCRUBBING=true

# ------------------------------------------------------------
# YAPAY ZEKA BAGLANTISI
#
# Claude, bu dosyadan DEGIL yonetici panelinden baglanir:
#     https://<adresiniz>/admin.html
#
# Asagidaki ayar, dosyada kazara kalan bir API anahtarinin
# kullanilmasini engeller.
# ------------------------------------------------------------
CUSTOMER_DEPLOYMENT=true
